{
  "expo": {
    "name": "Faro Pesquero",
    "slug": "faro-pesquero-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "faropesquero",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#040C18",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pe.faropesquero.app"
    },
    "android": {
      "package": "pe.faropesquero.app",
      "adaptiveIcon": {
        "backgroundColor": "#040C18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Faro Pesquero escucha el mar para reconocer el canto de piqueros, pelícanos y gaviotas."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Faro Pesquero usa tu posición para guiarte a las zonas de pesca y anotar dónde se detectó cada ave."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Faro Pesquero usa los sensores de movimiento y presión para medir el oleaje y anticipar mal tiempo."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97c82ce8-8d15-432d-a053-a7d17b209d7d"
      }
    },
    "owner": "marcobo_739"
  }
}
